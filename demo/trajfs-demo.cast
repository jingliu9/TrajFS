[20.848, "o", "\u001b[90m# ... still running. On this host it takes 1m 12s. Skipping ahead.\u001b[0m\r\n"]
[20.848, "o", "\u001b[0m\r\n"]
[21.648, "o", "\u001b[1m  measured on this host\u001b[0m\u001b[90m  —  999,580 files, 5.4 GB on disk, git version 2.43.0\u001b[0m\r\n"]
[21.648, "o", "\u001b[0m\r\n"]
[21.868, "o", "    git add -A                      \u001b[91m   1m 03s\u001b[0m   \u001b[90m\u001b[0m\r\n"]
[22.088, "o", "    git commit -m \"round 40\"        \u001b[91m    8.3 s\u001b[0m   \u001b[90m\u001b[0m\r\n"]
[22.308, "o", "    git status                      \u001b[91m    2.3 s\u001b[0m   \u001b[90m\u001b[0m\r\n"]
[22.528, "o", "    git push                        \u001b[91m     17 s\u001b[0m   \u001b[90m\u001b[0m\r\n"]
[22.748, "o", "    git clone                       \u001b[91m    4.3 s\u001b[0m   \u001b[90mobjects only\u001b[0m\r\n"]
[22.968, "o", "    git checkout                    \u001b[91m   1m 01s\u001b[0m   \u001b[90mwrites 999,580 files\u001b[0m\r\n"]
[23.188, "o", "    .git                            \u001b[91m   352 MB\u001b[0m   \u001b[90mafter one commit\u001b[0m\r\n"]
[23.188, "o", "\u001b[0m\r\n"]
[23.588, "o", "\u001b[93m  ✗ every command walks a million files     ✗ every clone and checkout pays again\u001b[0m\r\n"]
[24.188, "o", "\u001b[93m  ✗ history grows by a whole tree per round  ✗ GitHub file-count and size limits\u001b[0m\r\n"]
