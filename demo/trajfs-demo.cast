[39.7924, "o", "\u001b[90m  fresh repository, warm cache: Git's best case\u001b[0m\r\n"]
[40.3924, "o", "\u001b[1m                            git on raw files          TrajFS\u001b[0m\r\n"]
[40.3924, "o", "\u001b[90m    ────────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[40.6924, "o", "    add + commit                      1m 12s            18 s   \u001b[1;92m   3.9x faster\u001b[0m  \u001b[90mpack + commit\u001b[0m\r\n"]
[40.9924, "o", "    status                             2.3 s          0.01 s   \u001b[1;92m   237x faster\u001b[0m  \u001b[90m\u001b[0m\r\n"]
[41.2924, "o", "    push                                17 s           6.8 s   \u001b[1;92m   2.5x faster\u001b[0m  \u001b[90m\u001b[0m\r\n"]
