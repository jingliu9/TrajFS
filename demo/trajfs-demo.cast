[18.248, "o", "\u001b[90m# ... still running. On this host it takes 1m 12s. Skipping ahead.\u001b[0m\r\n"]
[18.248, "o", "\u001b[0m\r\n"]
[19.048, "o", "\u001b[1m  measured on this host\u001b[0m\u001b[90m  —  999,580 files, 5.4 GB on disk, git version 2.43.0\u001b[0m\r\n"]
[19.048, "o", "\u001b[0m\r\n"]
[19.268, "o", "    git add -A                      \u001b[91m   1m 03s\u001b[0m   \u001b[90m\u001b[0m\r\n"]
[19.488, "o", "    git commit -m \"round 40\"        \u001b[91m    8.3 s\u001b[0m   \u001b[90m\u001b[0m\r\n"]
[19.708, "o", "    git status                      \u001b[91m    2.3 s\u001b[0m   \u001b[90m\u001b[0m\r\n"]
[19.928, "o", "    git push                        \u001b[91m     17 s\u001b[0m   \u001b[90m\u001b[0m\r\n"]
[20.148, "o", "    git clone                       \u001b[91m    4.3 s\u001b[0m   \u001b[90mobjects only\u001b[0m\r\n"]
[20.368, "o", "    git checkout                    \u001b[91m   1m 01s\u001b[0m   \u001b[90mwrites 999,580 files\u001b[0m\r\n"]
[20.588, "o", "    .git                            \u001b[91m   352 MB\u001b[0m   \u001b[90mafter one commit\u001b[0m\r\n"]
[20.588, "o", "\u001b[0m\r\n"]
[21.088, "o", "\u001b[90m  and that was the easy case: a fresh repository, files already in the page cache\u001b[0m\r\n"]
[21.388, "o", "    git add -A, repo already tracks 2,686,320 paths\u001b[91m  30m 16s\u001b[0m   \u001b[90mmeasured\u001b[0m\r\n"]
[21.688, "o", "    first read of the files from a cold disk    \u001b[91m  ~1h 19m\u001b[0m   \u001b[90m209 files/s measured\u001b[0m\r\n"]
[21.688, "o", "\u001b[0m\r\n"]
[22.088, "o", "\u001b[93m  ✗ every command walks a million files     ✗ every clone and checkout pays again\u001b[0m\r\n"]
[22.688, "o", "\u001b[93m  ✗ history grows by a whole tree per round  ✗ GitHub file-count and size limits\u001b[0m\r\n"]
