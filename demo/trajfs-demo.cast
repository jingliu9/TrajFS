[41.8924, "o", "    repository size                   352 MB           69 MB   \u001b[1;92m   5.1x smaller\u001b[0m  \u001b[90m.git vs store\u001b[0m\r\n"]
[47.8924, "m", "3b at scale"]
[47.8924, "o", "\u001b[2J\u001b[H"]
[47.8924, "o", "\u001b[1m\u001b[97m── 3 · The case that hurts: a repository that already holds runs \u001b[0m\u001b[90m──────────────────────────────────\u001b[0m\r\n"]
[47.8924, "o", "\u001b[0m\r\n"]
[47.8924, "o", "\u001b[0m\r\n"]
[48.1924, "o", "\u001b[90m# Git keeps every tracked path in one index. Adding the next run costs per path already there;\u001b[0m\r\n"]
[48.4924, "o", "\u001b[90m# a store adds a handful of files per batch, so traj pack does not care what the repository holds.\u001b[0m\r\n"]
[48.4924, "o", "\u001b[0m\r\n"]
[48.9924, "o", "\u001b[1m    paths already tracked           git add of this run       traj pack\u001b[0m\r\n"]
[48.9924, "o", "\u001b[90m    ──────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
