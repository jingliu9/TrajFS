[50.7424, "o", "\u001b[0m\r\n"]
[51.2424, "o", "    \u001b[93m✗ 6h 16m for one git add once 11,000,000 paths are tracked\u001b[0m     \u001b[1;92m✓ traj pack: 11 s, always\u001b[0m\u001b[0m\r\n"]
[51.5424, "o", "\u001b[90m    on a cold disk the first read of the files costs ~1h 19m for any tool (209 files/s)\u001b[0m\r\n"]
